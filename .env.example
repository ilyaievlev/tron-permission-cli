# Network: mainnet, shasta, nile
TRON_NETWORK=shasta

# TronGrid API key (recommended for mainnet to avoid rate limits)
TRONGRID_API_KEY=

# Default account address to inspect/manage (Base58Check)
TRON_ACCOUNT=

# Optional for development/testing (DO NOT commit real keys! Prefer encrypted keys in keys/)
# OWNER_PRIVATE_KEY=
